{
  "name": "vendus-dashboard-backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cron:daily-vendus-consumption": "node dist/jobs/runDailyVendusConsumption.js",
    "cron:daily-vendus-consumption:dev": "tsx src/jobs/runDailyVendusConsumption.ts",
    "stock:adjust-from-lines": "node dist/jobs/runStockAdjustmentFromLines.js",
    "stock:adjust-from-lines:dev": "tsx src/jobs/runStockAdjustmentFromLines.ts",
    "stock:adjust-excluded-sales": "node dist/jobs/runStockAdjustmentFromLines.js",
    "stock:adjust-excluded-sales:dev": "tsx src/jobs/runStockAdjustmentFromLines.ts"
  },
  "overrides": {
    "pdfjs-dist": "5.6.205"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.2",
    "luxon": "^3.7.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.2.0",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
