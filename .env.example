VENDUS_BASE_URL=https://www.vendus.pt/ws
VENDUS_PER_PAGE=50
VENDUS_CONCURRENCY=6

PORT=3333

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-here

OPENAI_API_KEY=your-openai-api-key

HR_KIOSK_HMAC_SECRET=your-kiosk-hmac-secret

ENABLE_DAILY_CONSUMPTION_CRON=false
DAILY_CONSUMPTION_CRON_SCHEDULE=30 1 * * *
CRON_SECRET=your-cron-secret

# AES-256-GCM key (base64, must decode to 32 bytes) for encrypting reversible
# integration credentials — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=your-base64-32-byte-key

# AirMenu: ID da enterprise principal (única activa)
AIRMENU_ENTERPRISE_ID=your-airmenu-enterprise-id

# AirMenu: ID da enterprise de fecho (cash closings cutover) -> Should be removed eventually
AIRMENU_CLOSING_ENTERPRISE_ID=your-airmenu-closing-enterprise-id

# AirMenu: credenciais para o cutover job (runAirMenuCredentialsCutover) -> Should be removed eventually
AIRMENU_USERNAME=your-airmenu-username
AIRMENU_API_KEY=your-airmenu-api-key
AIRMENU_PASSWORD=your-airmenu-password

# Sales Summary module: AirMenu enterprise ID to aggregate (Angry Box main — see ADR-0012)
AIRMENU_SALES_SUMMARY_ENTERPRISE_ID=your-airmenu-enterprise-id

# Never set to true unless the device token screen is not working.
DEVICE_AUTH_BYPASS_UNATTENDED=false
